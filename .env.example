# Public (safe in the browser) — Supabase project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only — service role key, used by the API routes and the laptop watcher. Never expose it.
SUPABASE_SERVICE_KEY=eyJ...   # or SUPABASE_SERVICE_ROLE_KEY (the name Vercel's Supabase integration uses)
ADMIN_PIN=1234   # unlocks /admin
ADMIN_PIN=1234   # team PIN for /admin
